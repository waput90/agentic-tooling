{
  "name": "agentic-tooling",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Copilot workspaces with explicit execution approval",
  "author": "Agentic Tooling",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "capabilities": "tsx scripts/capabilities.ts",
    "package": "pnpm build && electron-builder --win nsis",
    "package:dir": "pnpm build && electron-builder --dir",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "format": "prettier --write .",
    "isolation:smoke": "tsx scripts/isolation-smoke.ts"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.28",
    "electron-updater": "6.8.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "dev.agentic.tooling",
    "productName": "Agentic Tooling",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@github/**",
      "node_modules/koffi/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "owner": "waput90",
        "provider": "github",
        "repo": "agentic-tooling",
        "releaseType": "release"
      }
    ]
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  }
}
